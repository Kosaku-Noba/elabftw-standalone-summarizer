# eLabFTW REST API configuration
ELAB_BASE_URL=https://localhost:4443/api/v2
ELAB_API_KEY=your-elabftw-api-key-here
ELAB_VERIFY_SSL=false
ELAB_TIMEOUT=30
ELAB_PAGE_SIZE=50
ELAB_MAX_PAGES=20
ELAB_RETRY_ATTEMPTS=3
ELAB_RETRY_BACKOFF_SECONDS=2.0

# LLM backend configuration
# Supported backends: ollama, llamacpp, azure_openai
LLM_BACKEND=ollama
LLM_ENDPOINT_URL=http://127.0.0.1:11434
LLM_MODEL_ID=qwen2.5:3b-instruct-q4
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_INPUT_CHARS=3000
LLM_CONTEXT_WINDOW=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=2.0
LLM_SYSTEM_PROMPT=./prompts/system.txt

# Azure OpenAI example:
# LLM_BACKEND=azure_openai
# LLM_ENDPOINT_URL=https://your-resource.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
# LLM_MODEL_ID=gpt-5.2-chat
# LLM_API_KEY=your-azure-openai-api-key-here

# Scheduler and logging
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MAX_ITEMS=10
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
TARGET_TAGS=summarize
